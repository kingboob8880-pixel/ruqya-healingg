<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0a0a1a">
    <title>Духовная прокачка | Ruhiy rivojlanish</title>
    <style>
        :root {
            --bg:#0a0a1a;--bg2:#111128;--bg3:#1a1a3e;--gold:#d4a574;--gold2:#e8c547;
            --gold-dim:rgba(212,165,116,0.15);--green:#2d6a4f;--green-l:#6fcf97;
            --blue:#4361ee;--purple:#7209b7;--red:#ef4444;--text:#e8e8f0;--dim:#6b6b8d;
            --border:#2a2a4a;--card:#13132d;--nav-h:64px;--safe-b:env(safe-area-inset-bottom,0px);
        }
        *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
        body{font-family:-apple-system,'SF Pro',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden;padding-bottom:calc(var(--nav-h) + var(--safe-b) + 10px);min-height:100vh;-webkit-font-smoothing:antialiased}
        body::before{content:'';position:fixed;top:0;left:0;right:0;bottom:0;background:radial-gradient(ellipse at 30% 20%,rgba(212,165,116,0.06) 0%,transparent 60%),radial-gradient(ellipse at 70% 80%,rgba(67,97,238,0.04) 0%,transparent 60%);pointer-events:none;z-index:0}

        .particles{position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:0;overflow:hidden}
        .p{position:absolute;border-radius:50%;background:var(--gold);opacity:0;animation:fp linear infinite}
        @keyframes fp{0%{opacity:0;transform:translateY(100vh) scale(0)}15%{opacity:.5}85%{opacity:.4}100%{opacity:0;transform:translateY(-5vh) scale(1)}}

        .screen{display:none;position:relative;z-index:1;animation:fadeUp .35s ease}
        .screen.active{display:block}
        @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

        /* TOP BAR */
        .top-bar{position:sticky;top:0;z-index:100;background:rgba(10,10,26,0.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:10px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}
        .top-title{font-size:1em;font-weight:700;background:linear-gradient(135deg,var(--gold),var(--gold2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .top-right{display:flex;align-items:center;gap:10px}
        .top-streak{font-size:.75em;color:var(--gold)}

        /* LANG SWITCHER */
        .lang-sw{display:flex;background:var(--bg3);border-radius:20px;overflow:hidden;border:1px solid var(--border)}
        .lang-btn{padding:5px 12px;font-size:.7em;font-weight:700;border:none;background:none;color:var(--dim);cursor:pointer;transition:all .2s}
        .lang-btn.active{background:var(--gold);color:#000;border-radius:20px}
        .lang-btn:active{transform:scale(.95)}

        /* HERO */
        .home-hero{text-align:center;padding:28px 20px 20px}
        .hero-icon{font-size:3.2em;animation:breathe 4s ease-in-out infinite}
        @keyframes breathe{0%,100%{transform:scale(1);filter:drop-shadow(0 0 8px rgba(212,165,116,.3))}50%{transform:scale(1.08);filter:drop-shadow(0 0 20px rgba(212,165,116,.6))}}
        .hero-title{font-size:1.5em;font-weight:800;margin-top:10px;background:linear-gradient(135deg,var(--gold),var(--gold2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .hero-sub{color:var(--dim);font-size:.85em;margin-top:4px}

        /* ENERGY */
        .energy-section{padding:0 16px 16px}
        .energy-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:14px}
        .energy-label{font-size:.75em;color:var(--dim);margin-bottom:6px;display:flex;justify-content:space-between}
        .energy-bar-bg{height:10px;background:var(--bg3);border-radius:5px;overflow:hidden}
        .energy-bar-fill{height:100%;border-radius:5px;background:linear-gradient(90deg,var(--green),var(--gold),var(--gold2));transition:width .8s ease;position:relative}
        .energy-bar-fill::after{content:'';position:absolute;top:0;right:0;bottom:0;width:30px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3));animation:shimmer 2s infinite}
        @keyframes shimmer{0%,100%{opacity:0}50%{opacity:1}}
        .energy-level-text{text-align:center;margin-top:8px;font-weight:700;color:var(--gold);font-size:.85em}

        /* QUICK STATS */
        .quick-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 16px 16px}
        .q-stat{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px 8px;text-align:center}
        .q-stat-icon{font-size:1.3em}
        .q-stat-num{font-size:1.3em;font-weight:800;color:var(--gold);margin-top:2px}
        .q-stat-label{font-size:.6em;color:var(--dim);margin-top:1px}

        /* AQEEDAH */
        .aqeedah-box{background:rgba(45,106,79,.08);border:1px solid rgba(45,106,79,.25);border-radius:14px;padding:14px;margin:0 16px 16px}
        .aqeedah-box h3{color:var(--green-l);font-size:.9em;margin-bottom:8px;display:flex;align-items:center;gap:6px}
        .aq-item{display:flex;align-items:flex-start;gap:6px;padding:5px 0;font-size:.78em;color:#a0b0a8;border-bottom:1px solid rgba(45,106,79,.12)}
        .aq-item:last-child{border-bottom:none}

        /* MENU */
        .menu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:0 16px 16px}
        .menu-item{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px 12px;text-align:center;cursor:pointer;transition:all .3s;-webkit-user-select:none;user-select:none;position:relative;overflow:hidden}
        .menu-item::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:3px 3px 0 0}
        .menu-item:active{transform:scale(.96);background:var(--bg3)}
        .menu-item .m-icon{font-size:1.8em;margin-bottom:6px}
        .menu-item .m-title{font-weight:700;font-size:.82em;margin-bottom:2px}
        .menu-item .m-sub{font-size:.65em;color:var(--dim)}
        .mi-1::before{background:var(--green)}.mi-2::before{background:var(--gold)}.mi-3::before{background:var(--blue)}.mi-4::before{background:var(--purple)}.mi-5::before{background:var(--gold2)}.mi-6::before{background:#40c057}.mi-7::before{background:var(--red)}.mi-8::before{background:#e066ff}
        .section-count{text-align:center;padding:8px;font-size:.7em;color:var(--dim)}

        /* DETAIL */
        .detail-header{padding:16px;display:flex;align-items:center;gap:12px}
        .back-btn{width:38px;height:38px;border-radius:12px;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.1em;cursor:pointer;color:var(--text);transition:all .2s}
        .back-btn:active{background:var(--bg3);transform:scale(.95)}
        .detail-title-area{flex:1}
        .detail-title{font-size:1.1em;font-weight:800}
        .detail-sub{font-size:.75em;color:var(--dim)}
        .detail-content{padding:0 16px 20px}

        /* PRACTICE CARDS */
        .pcard{background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;overflow:hidden;transition:all .3s}
        .pcard-head{padding:12px 14px;display:flex;align-items:center;gap:10px;cursor:pointer;-webkit-user-select:none;user-select:none}
        .pcard-head:active{background:var(--bg3)}
        .pcard-icon{font-size:1.3em;flex-shrink:0}
        .pcard-info{flex:1}
        .pcard-name{font-weight:700;font-size:.9em}
        .pcard-brief{font-size:.7em;color:var(--dim);margin-top:1px}
        .pcard-arrow{color:var(--dim);font-size:.75em;transition:transform .3s}
        .pcard-arrow.open{transform:rotate(180deg)}
        .pcard-body{display:none;padding:0 14px 14px;animation:fadeUp .3s ease}
        .pcard-body.open{display:block}
        .pcard-desc{font-size:.82em;color:var(--dim);margin-bottom:10px;line-height:1.7}
        .pcard-how{background:var(--gold-dim);border:1px solid rgba(212,165,116,.2);border-radius:10px;padding:10px;font-size:.82em;margin-bottom:8px;line-height:1.8}
        .pcard-how strong{color:var(--gold)}
        .pcard-ayah{background:rgba(45,106,79,.1);border:1px solid rgba(45,106,79,.2);border-radius:10px;padding:10px;font-size:.78em;color:var(--green-l);font-style:italic;margin-bottom:8px;line-height:1.7}
        .pcard-tags{display:flex;flex-wrap:wrap;gap:5px}
        .ptag{padding:2px 8px;border-radius:20px;font-size:.6em;font-weight:600}
        .ptag-d{background:rgba(64,192,87,.15);color:#40c057}
        .ptag-e{background:rgba(212,165,116,.15);color:var(--gold)}
        .ptag-a{background:rgba(114,9,183,.15);color:#b766e8}
        .ptag-n{background:rgba(30,30,80,.5);color:#8888cc;border:1px solid #3a3a6a}
        .ptag-w{background:rgba(67,97,238,.15);color:var(--blue)}

        /* SCHEDULE */
        .time-row{display:flex;gap:10px;padding:12px 0;border-bottom:1px solid var(--border)}
        .time-row:last-child{border-bottom:none}
        .time-badge{min-width:50px;font-size:.65em;font-weight:700;color:var(--gold);padding-top:2px}
        .time-items{flex:1}
        .time-item{display:flex;align-items:flex-start;gap:6px;padding:3px 0;font-size:.8em}
        .time-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0;margin-top:7px}

        /* TRACKER */
        .tracker-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;padding:0 16px 14px}
        .tr-day{aspect-ratio:1;border-radius:10px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:.8em;font-weight:600;cursor:pointer;transition:all .2s;border:2px solid transparent;-webkit-user-select:none;user-select:none}
        .tr-day:active{transform:scale(.9)}
        .tr-day.done{background:rgba(212,165,116,.2);border-color:var(--gold);color:var(--gold)}
        .tr-day.today{border-color:var(--gold2);box-shadow:0 0 12px rgba(232,197,71,.3)}
        .tracker-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:0 16px 16px}
        .tr-sum{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px;text-align:center}
        .tr-sum-n{font-size:1.4em;font-weight:800;color:var(--gold)}
        .tr-sum-l{font-size:.6em;color:var(--dim);margin-top:1px}

        /* LEVELS */
        .lvl-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:10px;transition:all .3s}
        .lvl-card.current{border-color:var(--gold);box-shadow:0 0 20px rgba(212,165,116,.1)}
        .lvl-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
        .lvl-name{font-weight:700;font-size:.9em;display:flex;align-items:center;gap:6px}
        .lvl-dur{font-size:.65em;color:var(--dim);padding:2px 8px;background:var(--bg3);border-radius:20px}
        .lvl-desc{font-size:.75em;color:var(--dim);margin-bottom:8px}
        .lvl-skills{display:flex;flex-wrap:wrap;gap:5px}
        .lvl-skill{padding:2px 8px;border-radius:6px;font-size:.65em;background:var(--gold-dim);color:var(--gold);border:1px solid rgba(212,165,116,.2)}

        /* BOTTOM NAV */
        .bottom-nav{position:fixed;bottom:0;left:0;right:0;height:calc(var(--nav-h) + var(--safe-b));padding-bottom:var(--safe-b);background:rgba(10,10,26,.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-around;z-index:200}
        .nav-btn{display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 12px;border-radius:12px;cursor:pointer;transition:all .2s;-webkit-user-select:none;user-select:none;border:none;background:none;color:var(--dim)}
        .nav-btn:active{transform:scale(.9)}
        .nav-btn.active{color:var(--gold)}
        .nav-btn .nav-icon{font-size:1.3em}
        .nav-btn .nav-label{font-size:.55em;font-weight:600}
    </style>
</head>
<body>
<div class="particles" id="particles"></div>

<!-- TOP BAR -->
<div class="top-bar">
    <div class="top-title" id="topTitle">🤲 Духовная прокачка</div>
    <div class="top-right">
        <div class="top-streak" id="topStreak">🔥 0</div>
        <div class="lang-sw">
            <button class="lang-btn active" id="langRu" onclick="setLang('ru')">RU</button>
            <button class="lang-btn" id="langUz" onclick="setLang('uz')">UZ</button>
        </div>
    </div>
</div>

<!-- HOME -->
<div id="s-home" class="screen active">
    <div class="home-hero">
        <div class="hero-icon">🌟</div>
        <div class="hero-title" data-t="heroTitle"></div>
        <div class="hero-sub" data-t="heroSub"></div>
    </div>
    <div class="energy-section">
        <div class="energy-card">
            <div class="energy-label"><span data-t="spiritPower"></span><span id="energyPct">0%</span></div>
            <div class="energy-bar-bg"><div class="energy-bar-fill" id="energyFill" style="width:0%"></div></div>
            <div class="energy-level-text" id="energyLvl"></div>
        </div>
    </div>
    <div class="quick-stats">
        <div class="q-stat"><div class="q-stat-icon">📅</div><div class="q-stat-num" id="qDays">0</div><div class="q-stat-label" data-t="days"></div></div>
        <div class="q-stat"><div class="q-stat-icon">🔥</div><div class="q-stat-num" id="qStreak">0</div><div class="q-stat-label" data-t="streak"></div></div>
        <div class="q-stat"><div class="q-stat-icon">🎯</div><div class="q-stat-num" id="qLeft">40</div><div class="q-stat-label" data-t="remaining"></div></div>
    </div>
    <div class="aqeedah-box">
        <h3>🕌 <span data-t="aqeedahTitle"></span></h3>
        <div id="aqeedahList"></div>
    </div>
    <div class="menu-grid" id="menuGrid"></div>
    <div class="section-count" data-t="sectionCount"></div>
</div>

<!-- DETAIL -->
<div id="s-detail" class="screen">
    <div class="detail-header">
        <div class="back-btn" onclick="goHome()">←</div>
        <div class="detail-title-area">
            <div class="detail-title" id="detailTitle"></div>
            <div class="detail-sub" id="detailSub"></div>
        </div>
    </div>
    <div class="detail-content" id="detailContent"></div>
</div>

<!-- SCHEDULE -->
<div id="s-schedule" class="screen">
    <div class="detail-header">
        <div class="detail-title-area" style="text-align:center;width:100%">
            <div class="detail-title" data-t="scheduleTitle"></div>
            <div class="detail-sub" data-t="scheduleSub"></div>
        </div>
    </div>
    <div class="detail-content" id="scheduleContent"></div>
</div>

<!-- TRACKER -->
<div id="s-tracker" class="screen">
    <div class="detail-header">
        <div class="detail-title-area" style="text-align:center;width:100%">
            <div class="detail-title" data-t="trackerTitle"></div>
            <div class="detail-sub" data-t="trackerSub"></div>
        </div>
    </div>
    <div class="tracker-grid" id="trackerGrid"></div>
    <div class="tracker-summary">
        <div class="tr-sum"><div class="tr-sum-n" id="trDone">0</div><div class="tr-sum-l" data-t="completed"></div></div>
        <div class="tr-sum"><div class="tr-sum-n" id="trStreak">0</div><div class="tr-sum-l" data-t="streak"></div></div>
        <div class="tr-sum"><div class="tr-sum-n" id="trLeft">40</div><div class="tr-sum-l" data-t="remaining"></div></div>
    </div>
    <div class="detail-content">
        <div style="font-weight:700;font-size:1em;margin-bottom:12px;color:var(--gold)" data-t="levelsTitle"></div>
        <div id="levelsContainer"></div>
    </div>
</div>

<!-- BOTTOM NAV -->
<div class="bottom-nav">
    <button class="nav-btn active" onclick="switchTab('home')" id="nav-home">
        <span class="nav-icon">🏠</span><span class="nav-label" data-t="navHome"></span>
    </button>
    <button class="nav-btn" onclick="switchTab('schedule')" id="nav-schedule">
        <span class="nav-icon">📅</span><span class="nav-label" data-t="navSchedule"></span>
    </button>
    <button class="nav-btn" onclick="switchTab('tracker')" id="nav-tracker">
        <span class="nav-icon">📊</span><span class="nav-label" data-t="navTracker"></span>
    </button>
</div>

