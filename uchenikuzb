// ================================================================
// LANGUAGE ENGINE
// ================================================================
let LANG = localStorage.getItem('appLang') || 'ru';

function setLang(lang) {
    LANG = lang;
    localStorage.setItem('appLang', lang);
    document.getElementById('langRu').classList.toggle('active', lang==='ru');
    document.getElementById('langUz').classList.toggle('active', lang==='uz');
    renderAll();
}

function t(key) { return T[LANG][key] || T['ru'][key] || key; }

function renderAll() {
    // Simple text bindings
    document.querySelectorAll('[data-t]').forEach(el => {
        el.textContent = t(el.dataset.t);
    });
    document.getElementById('topTitle').textContent = t('topTitle');

    // Aqeedah
    const aqBox = document.getElementById('aqeedahList');
    aqBox.innerHTML = t('aqeedah').map(a => `<div class="aq-item">${a}</div>`).join('');

    // Menu
    const mg = document.getElementById('menuGrid');
    mg.innerHTML = t('menu').map(m =>
        `<div class="menu-item ${m.cls}" onclick="openDetail('${m.key}')">
            <div class="m-icon">${m.icon}</div>
            <div class="m-title">${m.title}</div>
            <div class="m-sub">${m.sub}</div>
        </div>`
    ).join('');

    // Schedule
    renderSchedule();

    // Levels
    renderLevels();

    // Stats
    updateStats();
}

function renderSchedule() {
    const sc = document.getElementById('scheduleContent');
    const sched = t('schedule');
    sc.innerHTML = `<div class="pcard" style="border-color:rgba(212,165,116,.2)"><div style="padding:14px">
        ${sched.map(s => `
            <div class="time-row">
                <div class="time-badge">${s.time}</div>
                <div class="time-items">
                    ${s.items.map(i => `<div class="time-item"><div class="time-dot"></div>${i}</div>`).join('')}
                </div>
            </div>
        `).join('')}
    </div></div>`;
}

function renderLevels() {
    const lc = document.getElementById('levelsContainer');
    const lvls = t('levels');
    lc.innerHTML = lvls.map((l,i) => `
        <div class="lvl-card" id="lvl${i+1}">
            <div class="lvl-head">
                <div class="lvl-name">${l.icon} ${l.name}</div>
                <div class="lvl-dur">${l.dur}</div>
            </div>
            <div class="lvl-desc">${l.desc}</div>
            <div class="lvl-skills">${l.skills.map(s => `<span class="lvl-skill">${s}</span>`).join('')}</div>
        </div>
    `).join('');
}

// ================================================================
// NAVIGATION
// ================================================================
function switchTab(tab) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('s-'+tab).classList.add('active');
    document.getElementById('nav-'+tab).classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
}

function goHome() { switchTab('home'); }

function openDetail(key) {
    const sections = T[LANG].sections || T['ru'].sections;
    const d = sections[key];
    if (!d) return;

    document.getElementById('detailTitle').textContent = d.title;
    document.getElementById('detailSub').textContent = d.sub;

    const tagMap = {d:'ptag-d',e:'ptag-e',a:'ptag-a',n:'ptag-n',w:'ptag-w'};
    const howLbl = t('howLabel');

    const container = document.getElementById('detailContent');
    container.innerHTML = d.items.map(item => {
        const tagsHTML = (item.tags||[]).map(t => `<span class="ptag ${tagMap[t[1]]||'ptag-d'}">${t[0]}</span>`).join('');
        const howText = (item.how||'').replace(/\n/g,'<br>');
        return `
        <div class="pcard">
            <div class="pcard-head" onclick="togglePCard(this)">
                <div class="pcard-icon">${item.icon}</div>
                <div class="pcard-info">
                    <div class="pcard-name">${item.name}</div>
                    <div class="pcard-brief">${item.brief}</div>
                </div>
                <div class="pcard-arrow">▼</div>
            </div>
            <div class="pcard-body">
                <div class="pcard-desc">${item.desc}</div>
                <div class="pcard-how"><strong>${howLbl}</strong><br>${howText}</div>
                ${item.ayah ? `<div class="pcard-ayah">${item.ayah}</div>` : ''}
                <div class="pcard-tags">${tagsHTML}</div>
            </div>
        </div>`;
    }).join('');

    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('s-detail').classList.add('active');
    document.getElementById('nav-home').classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
}

function togglePCard(head) {
    const body = head.nextElementSibling;
    const arrow = head.querySelector('.pcard-arrow');
    body.classList.toggle('open');
    arrow.classList.toggle('open');
}

// ================================================================
// TRACKER
// ================================================================
function initTracker() {
    const grid = document.getElementById('trackerGrid');
    grid.innerHTML = '';
    const saved = JSON.parse(localStorage.getItem('sp40')||'[]');
    for (let i=1;i<=40;i++) {
        const d = document.createElement('div');
        d.className = 'tr-day';
        if (saved.includes(i)) d.classList.add('done');
        d.textContent = i;
        d.onclick = () => toggleDay(i,d);
        grid.appendChild(d);
    }
    updateStats();
}

function toggleDay(n,el) {
    let saved = JSON.parse(localStorage.getItem('sp40')||'[]');
    if (!localStorage.getItem('sp40start')) localStorage.setItem('sp40start',Date.now().toString());
    if (saved.includes(n)) { saved=saved.filter(x=>x!==n); el.classList.remove('done'); }
    else { saved.push(n); el.classList.add('done'); }
    localStorage.setItem('sp40',JSON.stringify(saved));
    updateStats();
}

function updateStats() {
    const saved = JSON.parse(localStorage.getItem('sp40')||'[]');
    const done = saved.length;
    const left = 40 - done;
    const pct = Math.round((done/40)*100);

    let streak = 0;
    const sorted = [...saved].sort((a,b)=>b-a);
    for (let i=0;i<sorted.length;i++) {
        if (i===0||sorted[i]===sorted[i-1]-1) streak++;
        else break;
    }

    // Update displays
    const ids = {trDone:done,trStreak:streak,trLeft:left,qDays:done,qStreak:streak,qLeft:left};
    Object.entries(ids).forEach(([id,val])=>{const el=document.getElementById(id);if(el)el.textContent=val});

    document.getElementById('topStreak').innerHTML = '🔥 '+streak;
    document.getElementById('energyFill').style.width = pct+'%';
    document.getElementById('energyPct').textContent = pct+'%';

    const elvls = t('energyLevels');
    let lvl = elvls[0];
    if(pct>=15) lvl=elvls[1];
    if(pct>=35) lvl=elvls[2];
    if(pct>=60) lvl=elvls[3];
    if(pct>=85) lvl=elvls[4];
    if(pct>=100) lvl=elvls[5];
    document.getElementById('energyLvl').textContent = lvl;

    // Highlight level
    for(let i=1;i<=4;i++){const el=document.getElementById('lvl'+i);if(el)el.classList.remove('current');}
    let cl = pct<25?1:pct<50?2:pct<80?3:4;
    const clEl = document.getElementById('lvl'+cl);
    if(clEl) clEl.classList.add('current');
}

// ================================================================
// PARTICLES
// ================================================================
function makeParticles() {
    const c = document.getElementById('particles');
    for(let i=0;i<18;i++){
        const p=document.createElement('div');p.className='p';
        p.style.left=Math.random()*100+'%';
        p.style.animationDuration=(10+Math.random()*15)+'s';
        p.style.animationDelay=Math.random()*8+'s';
        const s=2+Math.random()*2;p.style.width=s+'px';p.style.height=s+'px';
        c.appendChild(p);
    }
}

